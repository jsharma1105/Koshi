  "keywords": [
    "mcp",
    "rag",
    "retrieval",
    "memory",
    "context-engineering"
  ],
  "mcpServers": {
    "koshi": {
      "command": "koshi-mcp",
      "args": [],
      "env": {
        "KOSHI_INDEX_PATH": "${workspaceFolder}",
        "KOSHI_MEMORY_FILE": "${userHome}/.koshi/memory.json"
      }
    }
  }
}
