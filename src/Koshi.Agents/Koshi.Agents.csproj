<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Koshi.Agents</RootNamespace>
    <AssemblyName>koshi-agents</AssemblyName>

    <!-- Global tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>koshi-agents</ToolCommandName>

    <!-- NuGet package metadata -->
    <PackageId>Koshi.Agents</PackageId>
    <Version>0.6.0</Version>
    <Title>Koshi Agents — sub-agent persona installer</Title>
    <Authors>Koshi Contributors</Authors>
    <Company>Koshi</Company>
    <Description>Installs the Koshi sub-agent personas (librarian, memory-keeper, context-packer, quality-coach, orchestrator) into Claude Code and GitHub Copilot CLI configurations. Companion tool to Koshi.Mcp.</Description>
    <Summary>One-command installer for Koshi sub-agent personas across Claude Code and Copilot CLI.</Summary>
    <Copyright>Copyright (c) Koshi Contributors</Copyright>
    <PackageTags>mcp;model-context-protocol;agent;claude;copilot;sub-agent;persona;installer;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jsharma1105/Koshi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jsharma1105/Koshi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See CHANGELOG.md for release notes.</PackageReleaseNotes>

    <!-- Quality / SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
  </ItemGroup>

  <!-- Embed the canonical persona files (single source of truth) as resources.
       The .md files live under .github/copilot/agents/ and .claude/agents/ at
       the repo root; this <Link> imports them without copying or duplicating. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\.github\copilot\agents\*.agent.md" LinkBase="Personas\copilot" />
    <EmbeddedResource Include="..\..\.claude\agents\*.md" LinkBase="Personas\claude" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Condition="Exists('..\..\CHANGELOG.md')" />
  </ItemGroup>

</Project>
