<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Koshi.Mcp</RootNamespace>
    <AssemblyName>koshi-mcp</AssemblyName>

    <!-- Global tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>koshi-mcp</ToolCommandName>

    <!-- NuGet package metadata -->
    <PackageId>Koshi.Mcp</PackageId>
    <Version>0.9.1</Version>
    <Title>Koshi MCP Server</Title>
    <Authors>Koshi Contributors</Authors>
    <Company>Koshi</Company>
    <Description>Koshi (講師) is a Model Context Protocol server that brings retrieval, context engineering, persistent memory, and quality scoring to any MCP-compatible AI client (Claude Code, Copilot CLI, Cursor, Windsurf, etc.). 100% offline — no API keys, no embeddings, no cloud required.</Description>
    <Summary>Context, Memory and Harness Engineering tools for any MCP-compatible AI client.</Summary>
    <Copyright>Copyright (c) Koshi Contributors</Copyright>
    <PackageTags>mcp;model-context-protocol;ai;llm;rag;retrieval;bm25;context-engineering;memory;agent;claude;copilot;cursor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jsharma1105/Koshi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jsharma1105/Koshi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See CHANGELOG.md for release notes.</PackageReleaseNotes>

    <!-- Quality / SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Native AOT readiness. IsAotCompatible turns on the trim / AOT / single-file
         analyzers without forcing every build to publish AOT, so `dotnet build`,
         `dotnet test`, and `dotnet pack` (for the global tool flavor) still work
         normally. Actual AOT artifacts are produced by the release.yml matrix via
         `dotnet publish -c Release -r <rid> -p:PublishAot=true`. IL warnings are
         hard errors so any future regression breaks the build, not the release. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL2117;IL2118;IL2119;IL2120;IL2121;IL2122;IL3000;IL3001;IL3002;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koshi.Core\Koshi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to latest stable for reproducible builds -->
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

  <!-- Embed the canonical persona files (single source of truth) as resources,
       so `koshi-mcp init` / `koshi-mcp install-personas` can write them out
       without depending on the Koshi.Agents companion tool. The .md files live
       under .github/copilot/agents/ and .claude/agents/ at the repo root;
       <Link> imports them without copying or duplicating. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\.github\copilot\agents\*.agent.md" LinkBase="Personas\copilot" />
    <EmbeddedResource Include="..\..\.claude\agents\*.md" LinkBase="Personas\claude" />
  </ItemGroup>

  <!-- Embed the per-ecosystem Layer-3 steering templates (#77 Layer 4) so
       `koshi-mcp init` can drop them into a project's auto-loaded rule
       files without depending on the repo layout. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\koshi.AGENTS.md" LinkBase="Templates" />
    <EmbeddedResource Include="..\..\templates\koshi.copilot-instructions.md" LinkBase="Templates" />
    <EmbeddedResource Include="..\..\templates\koshi.cursorrules" LinkBase="Templates" />
    <EmbeddedResource Include="..\..\templates\koshi.windsurfrules" LinkBase="Templates" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Condition="Exists('..\..\CHANGELOG.md')" />
  </ItemGroup>

</Project>
